# --- dependencies -----------------------------------------------------------
node_modules/
jspm_packages/
.pnp/
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/plugins
!.yarn/sdks

# --- build output -----------------------------------------------------------
# Electron Forge packages into out/ and makes installers into out/make/.
out/
dist/
build/Release/
build/Debug/
*.tsbuildinfo

# Installer artefacts, wherever a maker drops them.
*.nupkg
*.appx
*.msi
*.exe
!vendor/**/*.exe
RELEASES

# The generated application icon is a build product of build/make-icon.js,
# derived from a repository-tracked catalog image. Regenerate it with
#   node build/make-icon.js
# Comment the next line out if you would rather track the binary.
# build/icon.ico

# CI writes these into the repository root while composing a release; they are
# published as release assets, never committed.
/codename.json
/RELEASE_NOTES.md
# The line-count table CI measures at the tagged commit and pastes into the
# release body. Committing it would freeze one release's figure into the tree.
/LINE_COUNT.md

# Local helper bundles are generated from the tracked scripts and must not be
# committed alongside their source.
scripts.zip

# --- site build -------------------------------------------------------------
site/_site/
site/.cache/
# The installer manifest the landing page's download button is built from. It is
# generated at publish time from `gh release view` and never committed: a
# checked-in copy is stale the moment the next release ships, and the site would
# then advertise a download that 404s. No manifest means no button, on purpose.
site/release.json

# --- logs and local state ---------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.npm/
.eslintcache
coverage/
.nyc_output/

# --- environment and secrets ------------------------------------------------
# Never commit credentials, tokens or machine-specific toolchain paths.
.env
.env.*
!.env.example
*.pem
*.key
!design/**/*.key
secrets.json
.tool-versions.local

# --- editors and operating systems ------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# --- scratch ----------------------------------------------------------------
tmp/
temp/
scratch/

# Agent worktrees. Parallel agents each get a linked worktree here; git already
# tracks them through .git/worktrees, and the checkouts themselves are disposable.
# Committing one would commit a second copy of the whole tree.
.claude/worktrees/

# NOTE: vendor/winscp is a git submodule (upstream WinSCP source, used as the
# porting reference). It is tracked through .gitmodules and must NOT be listed
# here.
